# Linux Peripheral Controller - Docker Environment Configuration
# Copy this file to .env and customize for your setup by 'cp .env.example .env'

### Specify another docker image (optional):
# LPC_IMAGE="ghcr.io/ohf-voice/linux-peripherals-controller"
# LPC_IMAGE_TAG="latest"

### Enable debug mode (optional):
# ENABLE_DEBUG="1"

### Type of the device (required), see docs/configuration.md for the known types:
# DEVICE_TYPE="respeaker_2mic_v1"

### Settings of this device (optional): a TOML file, see docs/configuration.md
# Put the file in ./config next to docker-compose.yml, it is mounted as /config
# DEVICE_CONFIG="/config/device.toml"

### Host of the Linux-Voice-Assistant peripheral WebSocket API (optional):
# Use "localhost" when LVA runs on the same machine with network_mode: host
# LVA_HOST="localhost"

### Port of the Linux-Voice-Assistant peripheral WebSocket API (optional):
# LVA_PORT="6055"

### Device name in Home Assistant and over mDNS (optional, default: lpc-<MAC address>):
# CLIENT_NAME="lpc-kitchen"

### Address and port of the ESPHome API for Home Assistant (optional):
# Port 6054, so it does not clash with LVA on 6053
# HOST="0.0.0.0"
# PORT="6054"

### Announce LPC over mDNS so Home Assistant discovers it (optional, 1 or 0):
# ENABLE_ZEROCONF="1"

### Encrypt the ESPHome API with a key, as ESPHome devices do (optional):
# The key file is created with a new key if it is missing, next to the state file by default
# ENABLE_ENCRYPTION="1"
# ENCRYPTION_KEY_FILE="/data/encryption.key"

### File that keeps the child lock and the light across restarts (optional):
# STATE_FILE="/data/state.json"

### Run without the device: LEDs are only logged, no button can be pressed (optional):
# SIMULATE_HARDWARE="1"
